# Production settings for the live server. Copy to .env and fill in the
# blanks; everything not listed here takes its value from .env.example /
# config defaults. Never set APP_DEBUG=true here.
APP_NAME=MyBooks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://my-books.cloud

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# true on shared hosting; false only if Supervisor runs "php artisan queue:work".
QUEUE_WORK_FROM_SCHEDULER=true
DB_QUEUE_RETRY_AFTER=660

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@my-books.cloud"
MAIL_FROM_NAME="${APP_NAME}"

MYBOOKS_SUPPORT_EMAIL="support@my-books.cloud"

# Live Paystack keys belong only here, never on staging.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=my-books.cloud,www.my-books.cloud
CORS_ALLOWED_ORIGINS=https://my-books.cloud,https://www.my-books.cloud

MYBOOKS_HSTS_INCLUDE_SUBDOMAINS=false
MYBOOKS_HSTS_PRELOAD=false

BACKUP_ENABLED=true
# Add the off-site disk (",offsite") once BACKUP_S3_* are set; see README, "Backups".
BACKUP_DISKS=backups
BACKUP_KEEP_DAYS=30
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

ERROR_ALERTS_ENABLED=true
ERROR_ALERT_EMAIL=
