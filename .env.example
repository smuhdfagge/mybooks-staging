APP_NAME=MyBooks
# local for development; production on the live server (see .env.production.example).
APP_ENV=local
APP_KEY=
# Never true on a server that others can reach: it shows code and settings on errors.
# Set it to true on your own machine while developing.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# warning in production; debug fills the disk and can log personal data.
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS. Set to false only for plain-http local development.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# The scheduler works through the queue every minute (needed on shared hosting).
# Set to false only if Supervisor keeps "php artisan queue:work" running.
QUEUE_WORK_FROM_SCHEDULER=true
# Seconds before a job is retried by another worker; keep above the longest job (600s).
DB_QUEUE_RETRY_AFTER=660

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MyBooks Application Settings
MYBOOKS_SUPPORT_EMAIL="support@my-books.cloud"
MYBOOKS_IMPORT_MAX_FILE_SIZE=10240

# Optional modules (off until ready for a business)
MYBOOKS_FEATURE_QUOTATIONS=false
MYBOOKS_FEATURE_DELIVERY_NOTES=false
MYBOOKS_FEATURE_CREDIT_NOTES=false
MYBOOKS_FEATURE_WAREHOUSES=false
MYBOOKS_FEATURE_STOCK_TRANSFERS=false
MYBOOKS_FEATURE_ASSEMBLY=false
MYBOOKS_FEATURE_INVENTORY_VALUATION=false

# Data retention, in months (retention:purge runs monthly). Keep 84 (7 years)
# for tax records unless your adviser says otherwise.
MYBOOKS_RETENTION_TERMINATED_MONTHS=84
MYBOOKS_RETENTION_ACTIVITY_LOG_MONTHS=84
MYBOOKS_RETENTION_SOFT_DELETED_MONTHS=12

# HSTS (sent over HTTPS). Only turn these on once every subdomain has HTTPS.
MYBOOKS_HSTS_INCLUDE_SUBDOMAINS=false
MYBOOKS_HSTS_PRELOAD=false

# Live chat widget (Tawk.to). Defaults to the MyBooks widget; set it empty to hide it.
# TAWK_TO_URL=

# API (Sanctum). Tokens expire after this many minutes.
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=
# Domains whose browser sessions may call the API (comma-separated).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:8000
CORS_SUPPORTS_CREDENTIALS=false

# Previous APP_KEYs (comma-separated) after running key:rotate, so old data still decrypts.
APP_PREVIOUS_KEYS=

# First admin account (php artisan db:seed --class=AdminUserSeeder).
# A random password is used if ADMIN_PASSWORD is empty.
ADMIN_EMAIL=admin@mybooks.local
ADMIN_PASSWORD=

# Subscription payments (Paystack). Use test keys on staging.
# Webhook URL to set in the Paystack dashboard: https://<your-domain>/billing/paystack/webhook
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
PAYSTACK_BASE_URL=https://api.paystack.co

# Backups (php artisan mybooks:backup runs daily at 01:30). Add an off-site
# disk to BACKUP_DISKS, e.g. BACKUP_DISKS=backups,offsite (see README).
BACKUP_ENABLED=true
BACKUP_DISKS=backups
BACKUP_KEEP_DAYS=30
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFY_EMAIL=
# Off-site disk (after: composer require league/flysystem-aws-s3-v3 "^3.0")
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
BACKUP_MYSQLDUMP_PATH=mysqldump

# Server errors are emailed here (at most once an hour per error). Defaults to
# MYBOOKS_SUPPORT_EMAIL; on in production.
ERROR_ALERT_EMAIL=
# On by default only when APP_ENV=production.
# ERROR_ALERTS_ENABLED=true
ERROR_ALERT_MAX_PER_HOUR=20

